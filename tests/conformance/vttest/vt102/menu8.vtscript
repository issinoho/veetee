# vttest menu 8: VT102 insert/delete — terminal model VT102.
model vt102
size 24 80
answerback "Hello, world"
spawn ${VTTEST} 24x80.132
prompt "Enter choice number (0 - 12): "
send "8\r"
step menu8-accordion-80
step menu8-accordion-done-80
step menu8-insert-mode-80
step menu8-delete-char-80
step menu8-staggered-80
step menu8-staggered-dwl-80
step menu8-insert-char-80
step menu8-accordion-132
step menu8-accordion-done-132
step menu8-insert-mode-132
step menu8-delete-char-132
step menu8-staggered-132
step menu8-staggered-dwl-132
step menu8-insert-char-132
prompt "Enter choice number (0 - 12): "
send "0\r"
expect-exit
