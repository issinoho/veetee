# vttest menu 11.2: VT320 features — terminal model VT420.
# Not scripted here: page format/movement (11.2.3/4, milestone M3), terminal
# state reports and DECRPDE (11.2.5.4/6, M3).
model vt420
size 24 80
# The DECRSPS cursor test requests dozens of reports; allow it time.
timeout 90
spawn ${VTTEST} 24x80.132
prompt "Enter choice number (0 - 12): "
send "11\r"
prompt "Enter choice number (0 - 8): "
send "2\r"

# 11.2.2 cursor movement: pan down/up (SU/SD)
prompt "Enter choice number (0 - 6): "
send "2\r"
prompt "Enter choice number (0 - 4): "
send "1\r"
walk vt320-su "Enter choice number (0 - 4): "
send "2\r"
walk vt320-sd "Enter choice number (0 - 4): "
send "0\r"

# 11.2.5 reports
prompt "Enter choice number (0 - 6): "
send "5\r"
prompt "Enter choice number (0 - 6): "
send "2\r"
prompt "Enter choice number (0 - 7): "
send "7\r"
walk vt320-decxcpr "Enter choice number (0 - 7): "
send "0\r"

# 11.2.5.3 presentation state reports
prompt "Enter choice number (0 - 6): "
send "3\r"
prompt "Enter choice number (0 - 6): "
send "1\r"
prompt "Enter choice number (0 - 7): "
send "7\r"
walk vt320-deccir "Enter choice number (0 - 7): "
send "0\r"
prompt "Enter choice number (0 - 6): "
send "2\r"
prompt "Enter choice number (0 - 3): "
send "3\r"
walk vt320-dectabsr "): "
send "0\r"
prompt "Enter choice number (0 - 6): "
send "3\r"
prompt "Enter choice number (0 - 2): "
send "1\r"
walk vt320-decrpm-ansi "): "
send "2\r"
walk vt320-decrpm-dec "): "
send "0\r"
prompt "Enter choice number (0 - 6): "
send "4\r"
walk vt320-decrsps-cursor "): "
send "5\r"
walk vt320-decrsps-tabs "): "
send "6\r"
prompt "Enter choice number (0 - 11): "
send "2\r"
walk vt320-decrqss-decsasd "): "
send "3\r"
walk vt320-decrqss-sgr "): "
send "4\r"
walk vt320-decrqss-decsca "): "
send "5\r"
walk vt320-decrqss-decscpp "): "
send "6\r"
walk vt320-decrqss-decscl "): "
send "7\r"
walk vt320-decrqss-decslpp "): "
send "8\r"
walk vt320-decrqss-decssdt "): "
send "9\r"
walk vt320-decrqss-decstbm "): "
send "0\r"
prompt "Enter choice number (0 - 6): "
send "0\r"

# 11.2.5.5 user-preferred supplemental set
prompt "Enter choice number (0 - 6): "
send "5\r"
prompt "Enter choice number (0 - 4): "
send "4\r"
walk vt320-decrqupss "): "
send "0\r"
prompt "Enter choice number (0 - 6): "
send "0\r"

# 11.2.6.2 status line
prompt "Enter choice number (0 - 6): "
send "6\r"
prompt "Enter choice number (0 - 2): "
send "2\r"
prompt "Enter choice number (0 - 3): "
send "1\r"
walk vt320-status-simple "): "
send "2\r"
walk vt320-status-sgr "): "
send "3\r"
walk vt320-status-cup "): "
send "0\r"
prompt "Enter choice number (0 - 2): "
send "0\r"

prompt "Enter choice number (0 - 6): "
send "0\r"
prompt "Enter choice number (0 - 8): "
send "0\r"
prompt "Enter choice number (0 - 12): "
send "0\r"
expect-exit
