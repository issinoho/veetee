# vttest menu 11.3.2: VT420 cursor movement — terminal model VT420.
model vt420
size 24 80
spawn ${VTTEST} 24x80.132
prompt "Enter choice number (0 - 12): "
send "11\r"
prompt "Enter choice number (0 - 8): "
send "3\r"
prompt "Enter choice number (0 - 8): "
send "2\r"

# Without margins.
prompt "Enter choice number (0 - 10): "
send "7\r"
walk vt420-cursor-decbi "Enter choice number (0 - 10): "
send "8\r"
walk vt420-cursor-decfi "Enter choice number (0 - 10): "
send "9\r"
walk vt420-cursor-margins "Enter choice number (0 - 10): "
send "10\r"
walk vt420-cursor-other "Enter choice number (0 - 10): "

# DECLRMM on, margins in the middle half of the screen.
send "3\r"
prompt "Enter choice number (0 - 10): "
send "4\r"
prompt "Enter choice number (0 - 10): "
send "4\r"
prompt "Enter choice number (0 - 10): "
send "4\r"
prompt "Enter choice number (0 - 10): "
send "5\r"
prompt "Enter choice number (0 - 10): "
send "5\r"
prompt "Enter choice number (0 - 10): "
send "5\r"
prompt "Enter choice number (0 - 10): "
snapshot vt420-cursor-middle-menu
send "7\r"
walk vt420-cursor-mid-decbi "Enter choice number (0 - 10): "
send "8\r"
walk vt420-cursor-mid-decfi "Enter choice number (0 - 10): "
send "9\r"
walk vt420-cursor-mid-margins "Enter choice number (0 - 10): "
send "10\r"
walk vt420-cursor-mid-other "Enter choice number (0 - 10): "

# And origin mode.
send "2\r"
prompt "Enter choice number (0 - 10): "
send "9\r"
walk vt420-cursor-mid-decom-margins "Enter choice number (0 - 10): "
send "10\r"
walk vt420-cursor-mid-decom-other "Enter choice number (0 - 10): "
send "0\r"
prompt "Enter choice number (0 - 8): "
send "0\r"
prompt "Enter choice number (0 - 8): "
send "0\r"
prompt "Enter choice number (0 - 12): "
send "0\r"
expect-exit
