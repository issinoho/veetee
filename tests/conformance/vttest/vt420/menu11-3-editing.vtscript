# vttest menu 11.3.3: VT420 editing sequences — terminal model VT420.
model vt420
size 24 80
spawn ${VTTEST} 24x80.132
prompt "Enter choice number (0 - 12): "
send "11\r"
prompt "Enter choice number (0 - 8): "
send "3\r"
prompt "Enter choice number (0 - 8): "
send "3\r"

# Without margins.
prompt "Enter choice number (0 - 13): "
send "6\r"
walk vt420-edit-declrmm "Enter choice number (0 - 13): "
send "9\r"
walk vt420-edit-decic "Enter choice number (0 - 13): "
send "10\r"
walk vt420-edit-ind "Enter choice number (0 - 13): "
send "11\r"
walk vt420-edit-il "Enter choice number (0 - 13): "
send "12\r"
walk vt420-edit-ich "Enter choice number (0 - 13): "
send "13\r"
walk vt420-edit-ascii "Enter choice number (0 - 13): "

# DECLRMM on, margins in the middle half of the screen.
send "2\r"
prompt "Enter choice number (0 - 13): "
send "3\r"
prompt "Enter choice number (0 - 13): "
send "3\r"
prompt "Enter choice number (0 - 13): "
send "3\r"
prompt "Enter choice number (0 - 13): "
send "4\r"
prompt "Enter choice number (0 - 13): "
send "4\r"
prompt "Enter choice number (0 - 13): "
send "4\r"
prompt "Enter choice number (0 - 13): "
send "6\r"
walk vt420-edit-mid-declrmm "Enter choice number (0 - 13): "
send "7\r"
walk vt420-edit-mid-decstbm "Enter choice number (0 - 13): "
send "8\r"
walk vt420-edit-mid-decslrm "Enter choice number (0 - 13): "
send "9\r"
walk vt420-edit-mid-decic "Enter choice number (0 - 13): "
send "10\r"
walk vt420-edit-mid-ind "Enter choice number (0 - 13): "
send "11\r"
walk vt420-edit-mid-il "Enter choice number (0 - 13): "
send "12\r"
walk vt420-edit-mid-ich "Enter choice number (0 - 13): "
send "13\r"
walk vt420-edit-mid-ascii "Enter choice number (0 - 13): "

# And origin mode.
send "1\r"
prompt "Enter choice number (0 - 13): "
send "9\r"
walk vt420-edit-decom-decic "Enter choice number (0 - 13): "
send "11\r"
walk vt420-edit-decom-il "Enter choice number (0 - 13): "
send "12\r"
walk vt420-edit-decom-ich "Enter choice number (0 - 13): "
send "0\r"
prompt "Enter choice number (0 - 8): "
send "0\r"
prompt "Enter choice number (0 - 8): "
send "0\r"
prompt "Enter choice number (0 - 12): "
send "0\r"
expect-exit
