# vttest menu 11.3.6: VT420 rectangular area functions — terminal model VT420.
model vt420
size 24 80
spawn ${VTTEST} 24x80.132
prompt "Enter choice number (0 - 12): "
send "11\r"
prompt "Enter choice number (0 - 8): "
send "3\r"
prompt "Enter choice number (0 - 8): "
send "6\r"

prompt "Enter choice number (0 - 12): "
send "7\r"
walk vt420-rect-deccara "Enter choice number (0 - 12): "
send "8\r"
walk vt420-rect-deccra "Enter choice number (0 - 12): "
send "9\r"
walk vt420-rect-decera "Enter choice number (0 - 12): "
send "10\r"
walk vt420-rect-decfra "Enter choice number (0 - 12): "
send "11\r"
walk vt420-rect-decrara "Enter choice number (0 - 12): "
send "12\r"
walk vt420-rect-decsera "Enter choice number (0 - 12): "

# Origin mode with margins in the middle half: coordinates are relative.
send "1\r"
prompt "Enter choice number (0 - 12): "
send "2\r"
prompt "Enter choice number (0 - 12): "
send "3\r"
prompt "Enter choice number (0 - 12): "
send "3\r"
prompt "Enter choice number (0 - 12): "
send "3\r"
prompt "Enter choice number (0 - 12): "
send "4\r"
prompt "Enter choice number (0 - 12): "
send "4\r"
prompt "Enter choice number (0 - 12): "
send "4\r"
prompt "Enter choice number (0 - 12): "
send "6\r"
prompt "Enter choice number (0 - 12): "
send "7\r"
walk vt420-rect-decom-deccara "Enter choice number (0 - 12): "
send "8\r"
walk vt420-rect-decom-deccra "Enter choice number (0 - 12): "
send "9\r"
walk vt420-rect-decom-decera "Enter choice number (0 - 12): "
send "10\r"
walk vt420-rect-decom-decfra "Enter choice number (0 - 12): "
send "11\r"
walk vt420-rect-decom-decrara "Enter choice number (0 - 12): "
send "12\r"
walk vt420-rect-decom-decsera "Enter choice number (0 - 12): "
send "0\r"
prompt "Enter choice number (0 - 8): "
send "0\r"
prompt "Enter choice number (0 - 8): "
send "0\r"
prompt "Enter choice number (0 - 12): "
send "0\r"
expect-exit
