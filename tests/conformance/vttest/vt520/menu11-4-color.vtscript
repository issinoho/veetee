# vttest menus 11.4.5.2.3.2 and 11.4.6.3: VT520 DECRQSS selections and
# alternate text colours — terminal model VT525.
model vt525
size 24 80
spawn ${VTTEST} 24x80.132
prompt "Enter choice number (0 - 12): "
send "11\r"
prompt "Enter choice number (0 - 8): "
send "4\r"
prompt "Enter choice number (0 - 6): "
send "5\r"
prompt "Enter choice number (0 - 3): "
send "2\r"
prompt "Enter choice number (0 - 3): "
send "3\r"
prompt "Enter choice number (0 - 12): "
send "2\r"
walk vt525-decatc "Enter choice number (0 - 12): "
send "3\r"
walk vt525-decac "Enter choice number (0 - 12): "
send "4\r"
walk vt525-deccrtst "Enter choice number (0 - 12): "
send "5\r"
walk vt525-decdlda "Enter choice number (0 - 12): "
send "6\r"
walk vt525-decsest "Enter choice number (0 - 12): "
send "7\r"
walk vt525-decarr "Enter choice number (0 - 12): "
send "8\r"
walk vt525-decstglt "Enter choice number (0 - 12): "
send "9\r"
walk vt525-decszs "Enter choice number (0 - 12): "
send "10\r"
walk vt525-decspma "Enter choice number (0 - 12): "
send "11\r"
walk vt525-dectme "Enter choice number (0 - 12): "
send "12\r"
walk vt525-decus "Enter choice number (0 - 12): "
send "0\r"
prompt "Enter choice number (0 - 3): "
send "0\r"
prompt "Enter choice number (0 - 3): "
send "0\r"
prompt "Enter choice number (0 - 6): "
send "6\r"
prompt "Enter choice number (0 - 3): "
send "3\r"
walk vt525-decatc-screen "Enter choice number (0 - 3): "
send "0\r"
prompt "Enter choice number (0 - 6): "
send "0\r"
prompt "Enter choice number (0 - 8): "
send "0\r"
prompt "Enter choice number (0 - 12): "
send "0\r"
expect-exit
