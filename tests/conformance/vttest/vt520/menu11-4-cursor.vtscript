# vttest menu 11.4.2: VT520 cursor movement — terminal model VT520.
model vt520
size 24 80
spawn ${VTTEST} 24x80.132
prompt "Enter choice number (0 - 12): "
send "11\r"
prompt "Enter choice number (0 - 8): "
send "4\r"
prompt "Enter choice number (0 - 6): "
send "2\r"

prompt "Enter choice number (0 - 15): "
send "7\r"
walk vt520-hpa "Enter choice number (0 - 15): "
send "8\r"
walk vt520-cbt "Enter choice number (0 - 15): "
send "9\r"
walk vt520-cha "Enter choice number (0 - 15): "
send "10\r"
walk vt520-cht "Enter choice number (0 - 15): "
send "11\r"
walk vt520-hpr "Enter choice number (0 - 15): "
send "12\r"
walk vt520-vpa "Enter choice number (0 - 15): "
send "13\r"
walk vt520-cnl "Enter choice number (0 - 15): "
send "14\r"
walk vt520-cpl "Enter choice number (0 - 15): "
send "15\r"
walk vt520-vpr "Enter choice number (0 - 15): "

# DECLRMM and origin mode on, margins in the middle half of the screen.
send "2\r"
prompt "Enter choice number (0 - 15): "
send "3\r"
prompt "Enter choice number (0 - 15): "
send "4\r"
prompt "Enter choice number (0 - 15): "
send "4\r"
prompt "Enter choice number (0 - 15): "
send "4\r"
prompt "Enter choice number (0 - 15): "
send "5\r"
prompt "Enter choice number (0 - 15): "
send "5\r"
prompt "Enter choice number (0 - 15): "
send "5\r"
prompt "Enter choice number (0 - 15): "
send "7\r"
walk vt520-mid-hpa "Enter choice number (0 - 15): "
send "8\r"
walk vt520-mid-cbt "Enter choice number (0 - 15): "
send "9\r"
walk vt520-mid-cha "Enter choice number (0 - 15): "
send "10\r"
walk vt520-mid-cht "Enter choice number (0 - 15): "
send "11\r"
walk vt520-mid-hpr "Enter choice number (0 - 15): "
send "12\r"
walk vt520-mid-vpa "Enter choice number (0 - 15): "
send "13\r"
walk vt520-mid-cnl "Enter choice number (0 - 15): "
send "14\r"
walk vt520-mid-cpl "Enter choice number (0 - 15): "
send "15\r"
walk vt520-mid-vpr "Enter choice number (0 - 15): "
send "0\r"
prompt "Enter choice number (0 - 6): "
send "0\r"
prompt "Enter choice number (0 - 8): "
send "0\r"
prompt "Enter choice number (0 - 12): "
send "0\r"
expect-exit
