# vttest menus 11.4.5 and 11.4.6: VT510/VT520 reports and screen display —
# terminal model VT520. DECATC and the VT520 DECRQSS page are in menu11-4-color.
model vt520
size 24 80
spawn ${VTTEST} 24x80.132
prompt "Enter choice number (0 - 12): "
send "11\r"
prompt "Enter choice number (0 - 8): "
send "4\r"

# 11.4.5.2 presentation state reports
prompt "Enter choice number (0 - 6): "
send "5\r"
prompt "Enter choice number (0 - 3): "
send "2\r"
prompt "Enter choice number (0 - 3): "
send "2\r"
prompt "Enter choice number (0 - 2): "
send "2\r"
walk vt520-decrpm-dec "Enter choice number (0 - 2): "
send "0\r"
prompt "Enter choice number (0 - 3): "
send "3\r"
prompt "Enter choice number (0 - 12): "
send "1\r"
prompt "Enter choice number (0 - 18): "
send "2\r"
walk vt510-decscp "Enter choice number (0 - 18): "
send "3\r"
walk vt510-decscs "Enter choice number (0 - 18): "
send "4\r"
walk vt510-decsdpt "Enter choice number (0 - 18): "
send "5\r"
walk vt510-decsddt "Enter choice number (0 - 18): "
send "6\r"
walk vt510-decsfc "Enter choice number (0 - 18): "
send "7\r"
walk vt510-decsprtt "Enter choice number (0 - 18): "
send "8\r"
walk vt510-decsppcs "Enter choice number (0 - 18): "
send "9\r"
walk vt510-decsrfr "Enter choice number (0 - 18): "
send "10\r"
walk vt510-decssl "Enter choice number (0 - 18): "
send "11\r"
walk vt510-decscusr "Enter choice number (0 - 18): "
send "12\r"
walk vt510-decskcv "Enter choice number (0 - 18): "
send "13\r"
walk vt510-decslck "Enter choice number (0 - 18): "
send "14\r"
walk vt510-decsmbv "Enter choice number (0 - 18): "
send "15\r"
walk vt510-decspp "Enter choice number (0 - 18): "
send "16\r"
walk vt510-decsscls "Enter choice number (0 - 18): "
send "17\r"
walk vt510-decstrl "Enter choice number (0 - 18): "
send "18\r"
walk vt510-decswbv "Enter choice number (0 - 18): "
send "0\r"
prompt "Enter choice number (0 - 12): "
send "0\r"
prompt "Enter choice number (0 - 3): "
send "0\r"
prompt "Enter choice number (0 - 3): "
send "0\r"

# 11.4.6 screen display
prompt "Enter choice number (0 - 6): "
send "6\r"
prompt "Enter choice number (0 - 3): "
send "1\r"
walk vt520-decncsm "Enter choice number (0 - 3): "
send "2\r"
walk vt520-decscusr "Enter choice number (0 - 3): "
send "0\r"
prompt "Enter choice number (0 - 6): "
send "0\r"
prompt "Enter choice number (0 - 8): "
send "0\r"
prompt "Enter choice number (0 - 12): "
send "0\r"
expect-exit
